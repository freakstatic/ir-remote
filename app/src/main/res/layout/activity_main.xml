<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_remote_gradient"
    android:fitsSystemWindows="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IR Remote"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:letterSpacing="0.18" />

                    <TextView
                        android:id="@+id/controllerNameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Z607"
                        android:textColor="@color/text_primary"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="112dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/status_pill"
                    android:text="Ready"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/remote_shell">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="22dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPower"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:text=""
                        app:icon="@drawable/ic_power_white"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="34dp"
                        app:iconTint="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_power_tint"
                        app:cornerRadius="46dp"
                        app:elevation="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOLUME"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="22dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVolDown"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:text="−"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_volume_tint"
                        app:cornerRadius="26dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMute"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text=""
                        app:icon="@drawable/ic_volume_off_white"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="28dp"
                        app:iconTint="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_mute_tint"
                        app:cornerRadius="34dp"
                        app:elevation="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVolUp"
                        android:layout_width="0dp"
                        android:layout_height="96dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:text="+"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_volume_tint"
                        app:cornerRadius="26dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INPUTS"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22"
                    android:layout_marginBottom="10dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:layout_marginBottom="22dp"
                    android:useDefaultMargins="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBluetooth"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="8dp"
                        android:text="Bluetooth"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_input_tint"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFmRadio"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="8dp"
                        android:text="FM Radio"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_input_tint"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAux"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="6dp"
                        android:text="AUX"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_input_tint"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRca"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="6dp"
                        android:text="RCA"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_input_tint"
                        app:cornerRadius="16dp" />
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MODE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.22"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="22dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSurround"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="5.1 / 2.1"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_default_tint"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChLevel"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="CH Level"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_default_tint"
                        app:cornerRadius="16dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSkipPrev"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        android:text="⏮"
                        android:textSize="22sp"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_default_tint"
                        app:cornerRadius="22dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlayPause"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1.2"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="7dp"
                        android:text="⏯"
                        android:textSize="24sp"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/accent_tint"
                        app:cornerRadius="22dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSkipNext"
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:text="⏭"
                        android:textSize="22sp"
                        android:textColor="@color/btn_content_tint"
                        app:backgroundTint="@color/btn_default_tint"
                        app:cornerRadius="22dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSdUsb"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="SD / USB"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                        android:textColor="@color/btn_content_tint"
                    app:backgroundTint="@color/surface_lifted_tint"
                    app:cornerRadius="18dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
